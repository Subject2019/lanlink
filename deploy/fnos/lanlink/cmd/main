#!/bin/bash
# LanLink 飞牛应用：启动 / 停止 / 状态
# 端口来自安装向导/应用设置（wizard_port），数据目录优先级：
#   向导值 > settings.conf > 用户授权目录（TRIM_DATA_ACCESSIBLE_PATHS）> 应用共享目录

APP_DIR="${TRIM_APPDEST}/server"
BIN="${APP_DIR}/lanlink-server"
PKGVAR="${TRIM_PKGVAR:-/tmp}"
PKGETC="${TRIM_PKGETC:-$PKGVAR}"
LOG_FILE="${PKGVAR}/app.log"
PID_FILE="${PKGVAR}/app.pid"
CONF="${PKGETC}/settings.conf"

port=""
data_dir=""
if [ -f "$CONF" ]; then
  # 由本应用自己写入的两行键值
  . "$CONF"
fi

PORT="${wizard_port:-${port:-${TRIM_SERVICE_PORT:-8787}}}"

log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"
}

check_process() {
  kill -0 "$1" 2>/dev/null
}

port_in_use() {
  ss -lnt 2>/dev/null | awk '{print $4}' | grep -qE "[:.]$1\$"
}

# 以应用用户身份判断目录可写（脚本若以 root 运行，直接写测试会误判）
can_write() {
  local dir="$1" rc
  [ -z "$dir" ] && return 1
  mkdir -p "$dir" 2>/dev/null
  if [ "$(id -u)" = "0" ] && [ -n "${TRIM_USERNAME:-}" ]; then
    su -s /bin/sh "$TRIM_USERNAME" -c ": > '$dir/.lanlink_write_test'" >/dev/null 2>&1
    rc=$?
  else
    : 2>/dev/null > "$dir/.lanlink_write_test"
    rc=$?
  fi
  rm -f "$dir/.lanlink_write_test" 2>/dev/null
  return $rc
}

# 依次尝试候选目录，返回第一个真正可写的
resolve_data_dir() {
  local d
  if [ -n "${wizard_data_dir:-}" ] && can_write "$wizard_data_dir"; then
    echo "$wizard_data_dir"
    return 0
  fi
  if [ -n "${data_dir:-}" ] && can_write "$data_dir"; then
    echo "$data_dir"
    return 0
  fi
  local IFS=':'
  for d in ${TRIM_DATA_ACCESSIBLE_PATHS:-}; do
    if can_write "$d"; then
      echo "$d"
      return 0
    fi
  done
  unset IFS
  if can_write "${TRIM_DATA_SHARE_PATHS%%:*}"; then
    echo "${TRIM_DATA_SHARE_PATHS%%:*}"
    return 0
  fi
  return 1
}

status_app() {
  if [ -f "$PID_FILE" ]; then
    local pid
    pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
    if [ -n "$pid" ] && check_process "$pid"; then
      return 0
    fi
    rm -f "$PID_FILE"
  fi
  return 1
}

start_app() {
  if status_app; then
    return 0
  fi

  if port_in_use "$PORT"; then
    log_msg "端口 $PORT 已被其他程序占用，启动失败。请在应用设置里换一个端口。"
    exit 1
  fi

  local resolved
  resolved="$(resolve_data_dir)" || {
    log_msg "没有可写的数据目录，启动失败。请在应用设置里更换数据目录，或先在「授权目录」里授权目标目录。"
    exit 1
  }
  if [ -n "${wizard_data_dir:-}" ] && [ "$resolved" != "$wizard_data_dir" ]; then
    log_msg "设置里的数据目录 ${wizard_data_dir} 不可写（多半是没在「授权目录」里授权），本次改用 $resolved"
  fi

  log_msg "Starting LanLink on :$PORT (data: $resolved)"
  cd "$APP_DIR" || exit 1
  # 默认免加入码，局域网设备打开网页填个名字就能用。
  # 需要加入码时删掉下面的 -open，加入码会写进本日志（app.log）。
  "$BIN" -addr ":$PORT" -data "$resolved" -open >> "$LOG_FILE" 2>&1 &
  echo "$!" > "$PID_FILE"
}

stop_app() {
  log_msg "Stopping LanLink..."
  if [ ! -f "$PID_FILE" ]; then
    return 0
  fi

  local pid
  pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
  if [ -z "$pid" ] || ! check_process "$pid"; then
    rm -f "$PID_FILE"
    return 0
  fi

  kill -TERM "$pid" 2>> "$LOG_FILE" || true
  local count=0
  while check_process "$pid" && [ "$count" -lt 10 ]; do
    sleep 1
    count=$((count + 1))
  done
  if check_process "$pid"; then
    kill -KILL "$pid" 2>> "$LOG_FILE" || true
  fi
  rm -f "$PID_FILE"
}

case "$1" in
  start)
    start_app
    ;;
  stop)
    stop_app
    ;;
  status)
    if status_app; then
      exit 0
    fi
    exit 3
    ;;
  *)
    echo "Unknown command: $1" > "${TRIM_TEMP_LOGFILE:-/dev/null}"
    exit 1
    ;;
esac
