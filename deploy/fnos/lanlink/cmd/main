#!/bin/bash
# LanLink 飞牛应用：启动 / 停止 / 状态
# 端口与数据目录来自安装向导（wizard_port / wizard_data_dir），
# 同时备份在 ${TRIM_PKGETC}/settings.conf，避免启动时拿不到向导变量。

APP_DIR="${TRIM_APPDEST}/server"
BIN="${APP_DIR}/lanlink-server"
PKGVAR="${TRIM_PKGVAR:-/tmp}"
PKGETC="${TRIM_PKGETC:-$PKGVAR}"
LOG_FILE="${PKGVAR}/app.log"
PID_FILE="${PKGVAR}/app.pid"
CONF="${PKGETC}/settings.conf"

port=""
data_dir=""
if [ -f "$CONF" ]; then
  # 由本应用自己写入的两行键值，内容已在校验阶段规范过
  . "$CONF"
fi

PORT="${wizard_port:-${port:-${TRIM_SERVICE_PORT:-8787}}}"
DATA_DIR="${wizard_data_dir:-${data_dir:-}}"
if [ -z "$DATA_DIR" ]; then
  DATA_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"
fi
if [ -z "$DATA_DIR" ]; then
  DATA_DIR="${PKGVAR}/data"
fi

log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"
}

check_process() {
  kill -0 "$1" 2>/dev/null
}

port_in_use() {
  ss -lnt 2>/dev/null | awk '{print $4}' | grep -qE "[:.]$1\$"
}

status_app() {
  if [ -f "$PID_FILE" ]; then
    local pid
    pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
    if [ -n "$pid" ] && check_process "$pid"; then
      return 0
    fi
    rm -f "$PID_FILE"
  fi
  return 1
}

start_app() {
  if status_app; then
    return 0
  fi

  if port_in_use "$PORT"; then
    log_msg "端口 $PORT 已被其他程序占用，启动失败。请在应用设置里换一个端口。"
    exit 1
  fi

  mkdir -p "$DATA_DIR" || {
    log_msg "无法创建数据目录 $DATA_DIR，启动失败。"
    exit 1
  }

  log_msg "Starting LanLink on :$PORT (data: $DATA_DIR)"
  cd "$APP_DIR" || exit 1
  # 默认免加入码，局域网设备打开网页填个名字就能用。
  # 需要加入码时删掉下面的 -open，加入码会写进本日志（app.log）。
  "$BIN" -addr ":$PORT" -data "$DATA_DIR" -open >> "$LOG_FILE" 2>&1 &
  echo "$!" > "$PID_FILE"
}

stop_app() {
  log_msg "Stopping LanLink..."
  if [ ! -f "$PID_FILE" ]; then
    return 0
  fi

  local pid
  pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
  if [ -z "$pid" ] || ! check_process "$pid"; then
    rm -f "$PID_FILE"
    return 0
  fi

  kill -TERM "$pid" 2>> "$LOG_FILE" || true
  local count=0
  while check_process "$pid" && [ "$count" -lt 10 ]; do
    sleep 1
    count=$((count + 1))
  done
  if check_process "$pid"; then
    kill -KILL "$pid" 2>> "$LOG_FILE" || true
  fi
  rm -f "$PID_FILE"
}

case "$1" in
  start)
    start_app
    ;;
  stop)
    stop_app
    ;;
  status)
    if status_app; then
      exit 0
    fi
    exit 3
    ;;
  *)
    echo "Unknown command: $1" > "${TRIM_TEMP_LOGFILE:-/dev/null}"
    exit 1
    ;;
esac
