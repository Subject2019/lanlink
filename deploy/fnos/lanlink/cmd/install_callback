#!/bin/bash
# 安装完成：校验端口；如果向导里给了数据目录，能写就记下来，不能写就提示并先用默认目录。
# 注意：安装阶段用户还没法「授权目录」，所以这里不做硬失败。

PKGVAR="${TRIM_PKGVAR:-/tmp}"
PKGETC="${TRIM_PKGETC:-$PKGVAR}"
LOG_FILE="${PKGVAR}/app.log"
CONF="${PKGETC}/settings.conf"

log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - [install] $1" >> "$LOG_FILE" 2>/dev/null
}

fail() {
  log_msg "$1"
  echo "$1" > "${TRIM_TEMP_LOGFILE:-/dev/null}"
  exit 1
}

can_write() {
  local dir="$1" rc
  [ -z "$dir" ] && return 1
  if [ "$(id -u)" = "0" ] && [ -n "${TRIM_USERNAME:-}" ]; then
    su -s /bin/sh "$TRIM_USERNAME" -c ": > '$dir/.lanlink_write_test'" >/dev/null 2>&1
    rc=$?
  else
    : 2>/dev/null > "$dir/.lanlink_write_test"
    rc=$?
  fi
  rm -f "$dir/.lanlink_write_test" 2>/dev/null
  return $rc
}

PORT="${wizard_port:-8787}"
case "$PORT" in
  ''|*[!0-9]*) fail "服务端口必须是数字，当前填的是：$PORT" ;;
esac
if [ "$PORT" -lt 1024 ] || [ "$PORT" -gt 65535 ]; then
  fail "服务端口需要在 1024-65535 之间，当前填的是：$PORT"
fi

DATA_DIR="${wizard_data_dir:-}"
log_msg "wizard_port=$PORT wizard_data_dir=${DATA_DIR:-（默认）} 执行用户=$(id -un)($(id -u))"

if [ -n "$DATA_DIR" ]; then
  case "$DATA_DIR" in
    /*) ;;
    *) DATA_DIR="" ; log_msg "数据目录不是绝对路径，改用默认目录" ;;
  esac
  case "$DATA_DIR" in
    *..*) DATA_DIR="" ; log_msg "数据目录包含 ..，改用默认目录" ;;
  esac
fi

if [ -n "$DATA_DIR" ]; then
  mkdir -p "$DATA_DIR" 2>/dev/null || DATA_DIR=""
  if [ -n "$DATA_DIR" ] && ! can_write "$DATA_DIR"; then
    log_msg "数据目录 $DATA_DIR 当前不可写（还没在「授权目录」里授权给应用），本次先使用默认目录"
    DATA_DIR=""
  fi
fi

if [ -n "$DATA_DIR" ]; then
  log_msg "数据目录已就绪：$DATA_DIR"
else
  log_msg "使用默认数据目录 ${TRIM_DATA_SHARE_PATHS%%:*}"
fi

mkdir -p "$PKGETC" 2>/dev/null
printf 'port=%s\ndata_dir=%s\n' "$PORT" "$DATA_DIR" > "$CONF" 2>/dev/null
chmod 644 "$CONF" 2>/dev/null

exit 0
